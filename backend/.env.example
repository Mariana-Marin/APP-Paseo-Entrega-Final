# ---------------------------------------------------------------------------
# Variables de entorno del backend de Paseo de San Francisco.
# Copia a .env (o expórtalas) según tu entorno de despliegue.
# ---------------------------------------------------------------------------

# Almacenamiento: auto | firestore | memoria
PASEO_ALMACENAMIENTO=auto

# Proyecto de Firebase
FIREBASE_PROJECT_ID=app-paseo---entrega-final

# Opción A (local): ruta al JSON de la cuenta de servicio
FIREBASE_CREDENCIALES=credenciales/firebase-service-account.json

# Opción B (nube): el mismo JSON pero codificado en Base64 (una sola línea)
# FIREBASE_CREDENCIALES_BASE64=

# Orígenes permitidos para el navegador (separa con comas). Incluye tu GitHub Pages.
PASEO_CORS_ORIGENES=http://localhost:5173,https://mariana-marin.github.io

# Puerto (muchos PaaS lo inyectan automáticamente)
PORT=8080
