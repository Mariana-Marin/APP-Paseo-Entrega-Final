# ---------------------------------------------------------------------------
# Configuración del frontend de Paseo de San Francisco
# Copia este archivo como .env y completa los valores. NO subas el .env al repo.
# ---------------------------------------------------------------------------

# URL base del backend (Spring Boot). En local déjalo así:
VITE_API_URL=http://localhost:8080/api

# --- Firebase (lo obtienes en la consola de Firebase > Configuración del proyecto
#     > Tus apps > SDK setup and configuration > Config). Sirve para:
#       1) Respaldo de lectura directa a Firestore si el backend no responde.
#       2) El asistente con IA (Gemini vía Firebase AI Logic).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=app-paseo---entrega-final.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=app-paseo---entrega-final
VITE_FIREBASE_STORAGE_BUCKET=app-paseo---entrega-final.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modelo de Gemini usado por el asistente (déjalo así salvo que te indiquen otro)
VITE_GEMINI_MODEL=gemini-3.8-flash

# (Opcional) Token de depuración de App Check para desarrollo local.
# Si App Check está activo, genera el token en consola y pégalo aquí.
VITE_APPCHECK_DEBUG_TOKEN=
